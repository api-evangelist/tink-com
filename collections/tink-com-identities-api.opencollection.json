{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tink Account Check Accounts Identities API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Identities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Tink List Identities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tink.com/data/v2/identities"
          },
          "docs": "List identity records returned by banks for the consented user."
        }
      ]
    }
  ],
  "bundled": true
}
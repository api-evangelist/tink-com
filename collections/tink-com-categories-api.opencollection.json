{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tink Account Check Accounts Categories API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Categories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Tink List Categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tink.com/enrichment/v1/categories",
            "params": [
              {
                "name": "locale",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List the Tink categorisation taxonomy for the calling locale."
        }
      ]
    }
  ],
  "bundled": true
}
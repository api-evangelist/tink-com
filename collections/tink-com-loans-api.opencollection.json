{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tink Account Check Accounts Loans API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Loans",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Tink List Loan Accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tink.com/data/v2/loan-accounts"
          },
          "docs": "List loan accounts the user has consented to share, including outstanding balance, interest rate, and term."
        },
        {
          "info": {
            "name": "Tink Get A Loan Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tink.com/data/v2/loan-accounts/:accountId",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve detailed information for a single loan account."
        }
      ]
    }
  ],
  "bundled": true
}
          "name": "Tink Create An OAuth Token",
          "request": {
            "name": "Tink Create An OAuth Token",
            "description": {
              "content": "Issue an OAuth 2.0 access token. Supports `client_credentials` for server-side calls, `authorization_code` to exchange a Tink Link or delegated grant code for a user token, and `refresh_token` to renew an existing user token without re-authentication.\n",
